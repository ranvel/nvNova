<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Legacy in-process WebView (PreviewController) runs JavaScriptCore's JIT,
	     which Hardened Runtime blocks by default. These exceptions keep the
	     Markdown/MultiMarkdown/Textile preview pane working under notarization. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
